DATABASE_URL=postgresql://postgres:password_here@localhost:5432/optiveildb

# Token de IA. OptiVeil usa OpenAI (api.openai.com) por defecto.
# Se busca en este orden: OPTIVEIL_AI_TOKEN -> OPENAI_API_KEY
OPENAI_API_KEY=sk-REPLACE_ME

# Opcional: otro proveedor compatible con OpenAI (Azure AI Foundry, Ollama, etc.)
# OPTIVEIL_AI_BASE_URL=https://tu-endpoint/v1
# Opcional: sobreescribir modelos (por defecto gpt-4o-mini)
# OPTIVEIL_ANALYST_MODEL=gpt-4o-mini
# OPTIVEIL_OFFENSIVE_MODEL=gpt-4o

# Opcional: alcance autorizado (scope). Si se define, /scan y /strategy/live
# rechazan objetivos fuera de alcance (403). Admite IP, CIDR y hostname.
# Alternativa: un archivo scope.txt (ver scope.txt.example). Sin scope => sin
# restricción. Cada petición queda registrada en results/audit.log.
# OPTIVEIL_SCOPE=192.168.1.0/24,10.0.0.5,scanme.nmap.org
# OPTIVEIL_SCOPE_FILE=scope.txt
